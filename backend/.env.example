# Port on which the backend Express server will run
PORT=3001

# MongoDB Connection URI (e.g. Atlas connection string or local MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/acadivio

# Google Gemini API Key (Required for AI Tutoring & Essay Grading features)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
